<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>batterytwin_simulator</name>
  <version>0.1.0</version>
  <description>Gazebo Plugin and ROS 2 Interface for BatteryTwin Simulator</description>
  <maintainer email="felopater@example.com">Felopater</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>batterytwin_msgs</depend>
  <depend>std_msgs</depend>
  <depend>ros_gz_sim</depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
