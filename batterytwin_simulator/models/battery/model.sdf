<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="battery_twin">
    <static>false</static>
    <link name="base_link">
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.2 0.4 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.8 0.1 1</ambient>
          <diffuse>0.1 0.8 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.2 0.4 0.1</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Attach our custom Gazebo plugin -->
    <plugin
      filename="batterytwin_plugin"
      name="batterytwin_simulator::BatteryTwinPlugin">
    </plugin>
  </model>
</sdf>
